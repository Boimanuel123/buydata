rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============ DEVELOPMENT MODE - ALLOW ALL FOR TESTING ============
    // TODO: Replace with strict rules (firestore.rules.production) before going live
    
    // Allow everyone to read/write everything (development only)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
