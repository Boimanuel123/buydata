rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Package reads are public. Writes happen through trusted server code.
    match /packages/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders are created and updated only by Firebase Admin on the server.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /supportMessages/{messageId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}